#include<bits\stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        bool isSubsegment = false;
        vector<int>v(n);
        for (int i = 0; i < n; i++)
        {
            cin>>v[i];
        }
        for (int i = 0; i < n; i++)
        {
            if(v[i] == k){
                isSubsegment = true;
            }
        }
        if (!isSubsegment)
        {
            cout<<"NO
";
        }else{
            cout<<"YES
";
        }
        
        
    }
}